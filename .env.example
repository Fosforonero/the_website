# Public base URL del sito (usato per metadata canonical, OG, sitemap, robots)
# Locale: http://localhost:3000
# Produzione: https://fosforonero.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (es. G-ABCD123456)
# Se non valorizzato, GA non viene caricato (sviluppo locale).
# In produzione: settare in Vercel -> Settings -> Environment Variables
NEXT_PUBLIC_GA_ID=

# ─── SiteBrain AI License Server ─────────────────────────────────────────────
# Supabase project dedicato o schema separato nel progetto esistente.
SB_SUPABASE_URL=https://your-project.supabase.co
SB_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (usa sk_test_ in sviluppo, sk_live_ in produzione)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs dei prodotti Stripe (da Dashboard → Products → Prices)
SB_PRICE_PRO=price_...
SB_PRICE_STUDIO=price_...
SB_PRICE_AGENCY=price_...

# URL del file ZIP del plugin PRO (deve iniziare con https://fosforonero.com)
SB_PRO_DOWNLOAD_URL=https://fosforonero.com/downloads/sitebrain-ai-pro-latest.zip

# Versione corrente del plugin PRO
SB_PRO_VERSION=1.0.2

# Email admin per notifiche licenze
ADMIN_EMAIL=mat.pizzi@gmail.com
